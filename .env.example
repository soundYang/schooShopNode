# 复制为 .env 后填写，不要把 .env 提交到仓库
PORT=3000
NODE_ENV=development

# MongoDB
DB_HOST=127.0.0.1
DB_PORT=27017
DB_NAME=SchoolShop
DB_USER=
DB_PASS=

# 必填：至少 32 位随机字符串
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Redis（可选，未配置时直接回源数据库）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# 百度内容审核（可选，未配置时审核功能不可用）
BAIDU_APP_ID=
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# Xorpay 支付（可选，未接入时使用余额支付）
XORPAY_APPID=
XORPAY_APPSECRET=
XORPAY_NOTIFY_URL=

# 允许跨域的前端地址，多个用逗号分隔
CORS_ORIGIN=http://localhost:5173

# 仅开发环境使用：种子管理员密码，至少 12 位
SEED_ADMIN_PASSWORD=
